<div class="donate-modal-overlay" id="donate-modal-overlay">
  <div class="donate-modal" role="dialog" aria-modal="true" aria-labelledby="donate-modal-title">
    <button type="button" class="donate-modal-close" id="donate-modal-close" aria-label="Close">&times;</button>

    <div class="donate-modal-eyebrow">Support The Collective</div>
    <h3 id="donate-modal-title">Donate to Botaki</h3>
    <p class="donate-modal-subtitle">Choose how you would like to contribute to keeping the craft alive.</p>

    <div class="donate-tabs">
      <button type="button" class="donate-tab active" data-donate-target="donate-monetary">Monetary</button>
      <button type="button" class="donate-tab" data-donate-target="donate-supplies">Art &amp; Gear</button>
    </div>

    <!-- Option A: Monetary donation -->
    <div class="donate-panel active" id="donate-monetary">
      <div class="donate-info-box">
        <span class="donate-label">Direct Bank Transfer (EFT)</span>
        <div class="donate-details">
          <p><strong>Bank:</strong> First National Bank (FNB)</p>
          <p><strong>Account Name:</strong> Botaki Ba Afrika</p>
          <p><strong>Account Number:</strong> 62000000000</p>
          <p><strong>Branch Code:</strong> 250655</p>
          <p><strong>Reference:</strong> Donate + Your Name</p>
        </div>
      </div>

      <a href="https://pay.yoco.com/botakibaafrika" target="_blank" rel="noopener noreferrer" class="btn btn-primary donate-cta">
        Donate Online via Card (Yoco)
      </a>
    </div>

    <!-- Option B: Art supplies & physical gear -->
    <div class="donate-panel" id="donate-supplies">
      <div class="donate-info-box">
        <span class="donate-label">Physical Contributions</span>
        <p class="donate-desc">We welcome physical drop-offs for materials that nourish our collective disciplines:</p>
        <ul class="donate-list">
          <li><strong>Visual Arts:</strong> Canvases, acrylic paints, brushes, clay, beads, textiles.</li>
          <li><strong>Music:</strong> Instruments, audio cables, mic stands, percussion gear.</li>
          <li><strong>Literature:</strong> Books for our library, notebooks, printing paper.</li>
        </ul>
      </div>

      <div class="donate-info-box" style="margin-top: 12px;">
        <span class="donate-label">Drop-off Address</span>
        <p class="donate-details">1005 Arcadia St, Hatfield, Pretoria, 0028</p>
        <p class="donate-details" style="margin-top: 4px;"><strong>Contact prior to drop-off:</strong> info@botakibaafrika.org.za</p>
      </div>

      <a href="mailto:info@botakibaafrika.org.za?subject=Art%20Supplies%20Donation" class="btn btn-secondary donate-cta" id="dropoff-btn">
        Arrange a Drop-off
      </a>
      <p id="dropoff-feedback" style="font-size:12px;color:var(--muted);margin-top:8px;text-align:center;display:none;">Email copied — opening your mail app…</p>
    </div>
  </div>
</div>
<script>
  // ---- Donate modal ----
  const donateOpenBtn = document.getElementById('donate-open-btn');
  const donateOverlay = document.getElementById('donate-modal-overlay');
  const donateCloseBtn = document.getElementById('donate-modal-close');

  if (donateOpenBtn && donateOverlay && donateCloseBtn) {
    donateOpenBtn.addEventListener('click', (e) => {
      e.preventDefault();
      donateOverlay.classList.add('is-open');
    });

    donateCloseBtn.addEventListener('click', () => {
      donateOverlay.classList.remove('is-open');
    });

    // click outside the modal card closes it
    donateOverlay.addEventListener('click', (e) => {
      if (e.target === donateOverlay) donateOverlay.classList.remove('is-open');
    });

    // Escape key closes it
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') donateOverlay.classList.remove('is-open');
    });
  }

  // ---- Donate tabs (Monetary / Art & Gear) ----
  document.querySelectorAll('.donate-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.donate-tab').forEach((t) => t.classList.remove('active'));
      document.querySelectorAll('.donate-panel').forEach((p) => p.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById(tab.dataset.donateTarget).classList.add('active');
    });
  });

  // ---- Drop-off email feedback ----
  const dropoffBtn = document.getElementById('dropoff-btn');
  const dropoffFeedback = document.getElementById('dropoff-feedback');
  if (dropoffBtn && dropoffFeedback) {
    dropoffBtn.addEventListener('click', () => {
      navigator.clipboard?.writeText('info@botakibaafrika.org.za').catch(() => {});
      dropoffFeedback.style.display = 'block';
      setTimeout(() => { dropoffFeedback.style.display = 'none'; }, 4000);
    });
  }
</script>
<script>
  const menuToggle = document.querySelector('.menu-toggle');
  const navLinks = document.querySelector('.nav-links');
  if (menuToggle && navLinks) {
    menuToggle.addEventListener('click', () => {
      const isOpen = navLinks.classList.toggle('nav-open');
      menuToggle.setAttribute('aria-expanded', String(isOpen));
    });
  }
  document.querySelectorAll('.nav-item').forEach(item => {
    const link = item.querySelector('.nav-link');
    link.addEventListener('click', (e) => {
      if (window.innerWidth <= 800) {
        e.preventDefault();
        item.classList.toggle('open');
      }
    });
  });
</script>

