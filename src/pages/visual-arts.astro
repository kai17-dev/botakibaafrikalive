<!-- ================================================================
     SCRIPT: Donate Modal
     ================================================================ -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  const donateBtn = document.querySelector('.nav-d[href="#donate"]');
  const donateModal = document.getElementById('donate-modal-overlay');
  const closeDonateBtn = document.getElementById('donate-modal-close');

  // Open modal when clicking the header "Donate" button
  donateBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    donateModal?.classList.add('is-open');
  });

  // Close modal handlers
  const closeDonateModal = () => donateModal?.classList.remove('is-open');
  closeDonateBtn?.addEventListener('click', closeDonateModal);
  donateModal?.addEventListener('click', (e) => {
    if (e.target === donateModal) closeDonateModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && donateModal?.classList.contains('is-open')) {
      closeDonateModal();
    }
  });

  // Tab switching inside Donate Modal
  const donateTabs = document.querySelectorAll('.donate-tab');
  const donatePanels = document.querySelectorAll('.donate-panel');
  donateTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      donateTabs.forEach(t => t.classList.remove('active'));
      donatePanels.forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      const targetId = tab.getAttribute('data-donate-target');
      document.getElementById(targetId)?.classList.add('active');
    });
  });

  // "Arrange a drop-off" — copy email as fallback if no default mail app is set
  const dropoffBtn = document.getElementById('dropoff-btn');
  const dropoffFeedback = document.getElementById('dropoff-feedback');
  dropoffBtn?.addEventListener('click', () => {
    if (navigator.clipboard) {
      navigator.clipboard.writeText('info@botakibaafrika.org.za').catch(() => {});
    }
    if (dropoffFeedback) {
      dropoffFeedback.style.display = 'block';
      setTimeout(() => { dropoffFeedback.style.display = 'none'; }, 4000);
    }
  });
});
</script>

<script>
  // Mobile nav toggle (matches homepage behavior)
  const menuToggle = document.querySelector('.menu-toggle');
  const navLinks = document.querySelector('.nav-links');
  if (menuToggle && navLinks) {
    menuToggle.addEventListener('click', () => {
      const isOpen = navLinks.classList.toggle('nav-open');
      menuToggle.setAttribute('aria-expanded', String(isOpen));
    });
  }
  // Mobile dropdown toggle for touch devices
  document.querySelectorAll('.nav-item').forEach(item => {
    const link = item.querySelector('.nav-link');
    link.addEventListener('click', (e) => {
      if (window.innerWidth <= 800) {
        e.preventDefault();
        item.classList.toggle('open');
      }
    });
  });
</script>

<!-- ================================================================
     SCRIPT: Back to Top
     Shows the button only once the person is within ~300px of the
     bottom of the page, hides it again once they scroll back up.
     ================================================================ -->
<script>
  const backToTopBtn = document.getElementById('back-to-top');

  function toggleBackToTop() {
    const scrollY = window.scrollY || window.pageYOffset;
    const viewportHeight = window.innerHeight;
    const pageHeight = document.documentElement.scrollHeight;
    const distanceFromBottom = pageHeight - (scrollY + viewportHeight);

    if (distanceFromBottom < 300) {
      backToTopBtn.classList.add('is-visible');
    } else {
      backToTopBtn.classList.remove('is-visible');
    }
  }

  backToTopBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  window.addEventListener('scroll', toggleBackToTop, { passive: true });
  window.addEventListener('resize', toggleBackToTop);
  toggleBackToTop(); // run once in case the page loads already scrolled
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Define your array of quotes and signatures
    const quotes = [
      {
        text: "&ldquo;We do not paint to decorate a wall. We paint because the wall was empty of us, and it was time it wasn't.&rdquo;",
        author: "— Visual Art Circle, Botaki Ba Afrika"
      },
      {
        text: "&ldquo;Line, color, and canvas are not just tools; they are the memory keepers of our people.&rdquo;",
        author: "— Naledi Khumalo"
      },
      {
        text: "&ldquo;Art is not a luxury for the quiet room. It is the noise we make when history tries to stay silent.&rdquo;",
        author: "— Sipho Radebe"
      },
      {
        text: "&ldquo;Every brushstroke is a signature written in defense of our place in the sun.&rdquo;",
        author: "— Thandi Mokoena"
      }
    ];

    let currentIndex = 0;
    const container = document.getElementById('quote-container');
    const quoteText = document.getElementById('quote-text');
    const quoteAuthor = document.getElementById('quote-author');

    if (container && quoteText && quoteAuthor) {
      setInterval(() => {
        // Fade out
        container.classList.add('fade-out');

        setTimeout(() => {
          // Advance index
          currentIndex = (currentIndex + 1) % quotes.length;

          // Update content
          quoteText.innerHTML = quotes[currentIndex].text;
          quoteAuthor.textContent = quotes[currentIndex].author;

          // Fade back in
          container.classList.remove('fade-out');
        }, 400); // 400ms matches the CSS transition duration
      }, 5000); // Rotates every 5000ms (5 seconds)
    }
  });
</script>

