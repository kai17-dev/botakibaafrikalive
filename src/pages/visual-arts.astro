<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Visual Art — Botaki Ba Afrika</title>
<style>
  :root {
    --cream: #EEF0C4;
    --yellow: #F3B417;
    --orange: #E97C2C;
    --brown: #5A2A0C;
    --green: #163C0A;
    --ink: #171512;
    --muted: #6B6858;
    --card-gray: #C9C9C4;
    --white: #FDFDF8;
  }

  @font-face {
    font-family: 'Lemon Milk';
    src: url('/fonts/LemonMilk.woff2') format('woff2'),
         url('/fonts/LemonMilk.woff') format('woff');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Lemon Milk';
    src: url('/fonts/LemonMilk-Bold.woff2') format('woff2'),
         url('/fonts/LemonMilk-Bold.woff') format('woff');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Lemon Milk';
    src: url('/fonts/LemonMilk-ExtraBold.woff2') format('woff2'),
         url('/fonts/LemonMilk-ExtraBold.woff') format('woff');
    font-weight: 800;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Avernire Medium';
    src: url('/fonts/Avernire-Medium.woff2') format('woff2'),
         url('/fonts/Avernire-Medium.woff') format('woff');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Avernire Medium', Arial, sans-serif;
    background: var(--white);
    color: var(--ink);
    line-height: 1.5;
  }
  h1, h2, h3, h4, h5, h6 { font-family: 'Lemon Milk', Arial, sans-serif; }
  a { color: inherit; text-decoration: none; }
  img, .ph { display: block; }
  .wrap { max-width: 1100px; margin: 0 auto; padding: 0 32px; }

  /* ---------- HEADER (shared across site) ---------- */
  header { background: var(--ink); position: sticky; top: 0; z-index: 50; }
  .header-inner { max-width: 1100px; margin: 0 auto; padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; position: relative; }
  .brandmark { width: 64px; height: 64px; border-radius: 50%; background: var(--white); display: flex; align-items: center; justify-content: center; }
  .brandmark svg { width: 32px; height: 32px; }
  nav { display: flex; align-items: center; gap: 24px; }
  .nav-links { display: flex; align-items: center; gap: 26px; }
  .nav-link { color: var(--white); font-size: 13px; letter-spacing: 0.08em; font-weight: 600; text-transform: uppercase; display: flex; align-items: center; gap: 5px; }
  .nav-link.is-active { color: var(--orange); }
  .nav-cta { background: var(--white); color: var(--ink); padding: 10px 18px; border-radius: 999px; font-size: 12px; letter-spacing: 0.06em; font-weight: 700; text-transform: uppercase; }
  .nav-d { background: var(--orange); color: var(--white); padding: 10px 18px; border-radius: 999px; font-size: 12px; letter-spacing: 0.06em; font-weight: 700; text-transform: uppercase; }
  .menu-toggle { display: none; background: none; border: none; color: var(--white); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; }
  .nav-item { position: relative; }
  .nav-item .caret { width: 6px; height: 6px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); margin-top: -3px; transition: transform 0.2s ease; }
  .nav-item:hover .caret, .nav-item.open .caret { transform: rotate(225deg); margin-top: 3px; }
  .nav-dropdown {
    position: absolute; top: 100%; left: 0; margin-top: 16px;
    background: var(--white); color: var(--ink); border-radius: 12px; padding: 10px;
    min-width: 180px; box-shadow: 0 12px 30px rgba(0,0,0,0.18);
    opacity: 0; visibility: hidden; transform: translateY(8px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
  }
  .nav-item:hover .nav-dropdown, .nav-item.open .nav-dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
  .nav-dropdown a { display: block; padding: 8px 12px; border-radius: 8px; font-size: 13px; font-weight: 600; text-transform: none; letter-spacing: 0; color: var(--ink); }
  .nav-dropdown a:hover { background: var(--cream); }

  @media (max-width: 800px) {
    .nav-links {
      display: none; position: absolute; top: 100%; left: 0; right: 0;
      background: var(--ink); flex-direction: column; align-items: flex-start;
      padding: 20px 32px; gap: 4px;
    }
    .nav-links.nav-open { display: flex; }
    .nav-item { width: 100%; }
    .nav-item .nav-link { width: 100%; padding: 10px 0; justify-content: space-between; }
    .nav-dropdown { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; background: rgba(255,255,255,0.06); width: 100%; margin: 0 0 8px; }
    .nav-dropdown a { color: var(--white); }
    .nav-dropdown a:hover { background: rgba(255,255,255,0.1); }
    .menu-toggle { display: block; }

    /* smaller header buttons on mobile */
    .header-inner { padding: 14px 16px; }
    nav { gap: 8px; }
    .nav-cta, .nav-d { padding: 8px 12px; font-size: 10.5px; letter-spacing: 0.04em; }
    .menu-toggle { font-size: 11px; margin-left: 2px; }
  }

  a:focus-visible, button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }

  /* =========================================================
     VISUAL ART PAGE — namespaced under .va-page so nothing here
     leaks into shared header/footer or other discipline pages
  ========================================================= */
  .va-page .section { padding: 64px 0; }

  /* ---- discipline hero ---- */
  .va-page .va-hero {
    padding: 72px 0 48px;
    position: relative;
    background-color: var(--white);
    background-image: url("/Resources/Backgrounds/Main%20BG%20Orange.svg");
    background-repeat: no-repeat;
    background-position: center center;
    background-size: cover;
  }
  .va-page .va-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    align-items: center;
  }
  .va-page .va-eyebrow {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 14px;
  }
  .va-page .va-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 800;
    font-size: clamp(40px, 6vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin-bottom: 20px;
  }
  .va-page .va-title em { font-style: italic; color: var(--orange); }
  .va-page .va-hero-copy p {
    color: var(--muted);
    font-size: 15px;
    max-width: 400px;
    margin-bottom: 24px;
  }
  .va-page .va-stat-row { display: flex; gap: 28px; }
  .va-page .va-stat .num { font-size: 22px; font-weight: 800; }
  .va-page .va-stat .label { font-size: 11.5px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }

  /* framed hero image */
  .va-page .va-frame {
    background: var(--white);
    padding: 14px;
    border-radius: 4px;
    box-shadow: 0 24px 50px -20px rgba(23,21,18,0.35);
    transform: rotate(1.2deg);
  }
  .va-page .va-frame .ph {
    background: var(--card-gray);
    aspect-ratio: 4 / 5;
    border-radius: 2px;
  }
  .va-page .va-frame .va-cap {
    display: flex;
    justify-content: space-between;
    padding: 10px 4px 2px;
    font-size: 11.5px;
    color: var(--muted);
  }

  /* ---- statement strip ---- */
  /* Smooth fade transition for the statement quote & author */
.va-page .va-statement .wrap {
  transition: opacity 0.4s ease, transform 0.4s ease;
}
.va-page .va-statement .wrap.fade-out {
  opacity: 0;
  transform: translateY(-4px);
}
  .va-page .va-statement {
    position: relative;
    background-color: var(--ink);
    background-image: url("/Resources/Backgrounds/Banner%20BG%20Orange.svg");
    background-repeat: no-repeat;
    background-position: center center;
    background-size: cover;
    color: var(--white);
    overflow: hidden;
  }
  .va-page .va-statement::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(23, 21, 18, 0.75); /* keeps the quote readable over the SVG */
  }
  .va-page .va-statement .wrap { position: relative; z-index: 1; padding: 56px 32px; }
  .va-page .va-statement p {
    font-family: Georgia, serif;
    font-size: clamp(20px, 2.6vw, 28px);
    line-height: 1.4;
    max-width: 760px;
  }
  .va-page .va-statement .va-sign {
    margin-top: 20px;
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--yellow);
  }

  /* ---- gallery wall (mosaic, matted frames) ---- */
  .va-page #gallery {
    position: relative;
    background-color: var(--white);
    background-image: url("/Resources/Backgrounds/Art%20Projects%20BG%20Black%202.svg");
    background-repeat: no-repeat;
    background-position: center center;
    background-size: cover;
  }
  .va-page #gallery .wrap { position: relative; z-index: 1; }
  .va-page .va-gallery-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
    gap: 20px;
    flex-wrap: wrap;
  }
  .va-page .va-gallery-head p { color: var(--muted); font-size: 14px; max-width: 360px; }

  .va-page .gallery-wall {
    columns: 3 240px;
    column-gap: 22px;
  }
  .va-page .g-piece {
    break-inside: avoid;
    margin-bottom: 22px;
    background: var(--white);
    padding: 10px;
    border-radius: 3px;
    box-shadow: 0 10px 24px -12px rgba(23,21,18,0.25);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .va-page .g-piece:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 34px -14px rgba(23,21,18,0.35);
  }
  .va-page .g-piece .ph { background: var(--card-gray); border-radius: 1px; width: 100%; }
  .va-page .g-piece.tall .ph { aspect-ratio: 3 / 4; }
  .va-page .g-piece.wide .ph { aspect-ratio: 4 / 3; }
  .va-page .g-piece.square .ph { aspect-ratio: 1 / 1; }
  .va-page .g-info { padding: 12px 4px 4px; display: flex; justify-content: space-between; gap: 10px; }
  .va-page .g-info h3 { font-size: 14px; font-weight: 700; }
  .va-page .g-info .g-artist { font-size: 12px; color: var(--muted); margin-top: 2px; }
  .va-page .g-tag {
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 9px;
    border-radius: 999px;
    white-space: nowrap;
    height: fit-content;
  }
  .va-page .g-tag.available { background: rgba(22,60,10,0.12); color: var(--green); }
  .va-page .g-tag.placed { background: rgba(107,104,88,0.14); color: var(--muted); }

  @media (max-width: 800px) {
    .va-page .va-hero-grid { grid-template-columns: 1fr; }
    .va-page .va-frame { transform: none; margin-top: 8px; }
    .va-page .gallery-wall { columns: 1 100%; }

    /* SVG backgrounds zoomed/repositioned so they read well on narrow screens */
    .va-page .va-hero { background-size: 150% auto; background-position: center top; }
    .va-page .va-statement { background-size: 200% auto; background-position: center center; }
    .va-page #gallery { background-size: 220% auto; background-position: center center; }
  }

  /* ---- featured artist spotlight ---- */
  .va-page .spotlight {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 44px;
    align-items: center;
    background: var(--yellow);
    border-radius: 18px;
    padding: 44px;
  }
  .va-page .spotlight .ph { aspect-ratio: 1 / 1; border-radius: 12px; }
  .va-page .spotlight .sp-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--white);
    margin-bottom: 10px;
  }
  .va-page .spotlight h3 { font-size: 24px; font-weight: 800; margin-bottom: 12px; }
  .va-page .spotlight p.bio { color: var(--white); font-size: 14.5px; margin-bottom: 16px; }
  .va-page .spotlight p.sp-quote {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: 17px;
    border-left: 3px solid var(--white);
    padding-left: 16px;
  }
  @media (max-width: 800px) {
    .va-page .spotlight { grid-template-columns: 1fr; padding: 28px; }
  }

  /* ---- join CTA ---- */
  .va-page .va-cta {
    background: var(--orange);
    color: var(--white);
    border-radius: 18px;
    padding: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .va-page .va-cta h2 { font-size: 26px; font-weight: 800; max-width: 460px; }
  .va-page .va-cta p { font-size: 14px; opacity: 0.9; max-width: 420px; margin-top: 6px; }
  .va-page .btn { padding: 12px 22px; border-radius: 999px; font-size: 13px; font-weight: 700; border: none; cursor: pointer; }
  .va-page .btn-dark { background: var(--ink); color: var(--white); }

  /* smaller buttons across the page on mobile */
  @media (max-width: 800px) {
    .va-page .btn { padding: 10px 16px; font-size: 12px; }
  }

  /* ============================================================
   BACK TO TOP BUTTON
   Fixed at bottom-right, hidden until the person nears the
   bottom of the page (see script at end of body).
   ============================================================ */
  .back-to-top {
    position: fixed;
    right: 24px;
    bottom: 24px;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--white);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 10px 24px -8px rgba(23,21,18,0.45);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
    z-index: 60;
  }
  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .back-to-top svg { width: 18px; height: 18px; }
  @media (max-width: 800px) {
    .back-to-top { width: 38px; height: 38px; right: 16px; bottom: 16px; }
    .back-to-top svg { width: 15px; height: 15px; }
  }

  /* ============================================================
   DONATE MODAL
   ============================================================ */
.donate-modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(23, 15, 5, 0.65);
  backdrop-filter: blur(3px);
  z-index: 1000;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.donate-modal-overlay.is-open { display: flex; }
.donate-modal {
  position: relative;
  background-color: var(--white);
  background-image: url("/Resources/Info%20Tab%20Bg%20Design/Design%201.svg");
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover;
  border: 3px solid var(--white);
  border-radius: 16px;
  max-width: 480px;
  width: 100%;
  padding: 32px;
  box-shadow: 0 20px 50px rgba(0,0,0,0.35);
  animation: event-modal-pop 0.25s ease;
  max-height: 90vh;
  overflow-y: auto;
}
.donate-modal-close { position: absolute; top: 12px; right: 16px; background: none; border: none; font-size: 28px; line-height: 1; color: var(--brown, #5A2A0C); cursor: pointer; }
.donate-modal-eyebrow { font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; font-size: 13px; color: var(--orange, #E97C2C); margin-bottom: 6px; }
.donate-modal h3 { font-family: 'Lemon Milk', Arial, sans-serif; font-size: 24px; margin: 0 0 6px; color: var(--brown, #5A2A0C); }
.donate-modal-subtitle { font-size: 14px; color: var(--muted); margin-bottom: 20px; }

.donate-tabs { display: flex; gap: 8px; margin-bottom: 20px; background: rgba(0, 0, 0, 0.05); padding: 4px; border-radius: 999px; }
.donate-tab { flex: 1; padding: 8px 14px; border-radius: 999px; border: none; background: transparent; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; cursor: pointer; color: var(--ink); transition: all 0.2s ease; }
.donate-tab.active { background: var(--ink); color: var(--white); }

.donate-panel { display: none; }
.donate-panel.active { display: block; }
.donate-info-box { background: rgba(255, 255, 255, 0.85); border: 1px solid rgba(23, 21, 18, 0.1); border-radius: 12px; padding: 16px; margin-bottom: 16px; }
.donate-label { display: block; font-weight: 700; text-transform: uppercase; font-size: 11px; letter-spacing: 0.05em; color: var(--green, #163C0A); margin-bottom: 8px; }
.donate-details { font-size: 13.5px; color: var(--brown, #5A2A0C); line-height: 1.5; }
.donate-desc { font-size: 13px; color: var(--muted); margin-bottom: 10px; }
.donate-list { padding-left: 18px; font-size: 13px; color: var(--ink); }
.donate-list li { margin-bottom: 6px; }
.donate-cta { width: 100%; text-align: center; margin-top: 8px; }

/* smaller donate modal buttons/tabs on mobile */
@media (max-width: 800px) {
  .donate-tab { padding: 7px 10px; font-size: 11px; }
  .donate-cta { padding: 10px 16px; font-size: 12px; }
}

/* ============================================================
   FOOTER
   ============================================================ */
footer {
  background-color: var(--ink);
  background-image: url("/Resources/Backgrounds/Footer%20BG%20Orange%202.svg");
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover;
  color: var(--white);
  position: relative;
}
footer::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(23, 21, 18, 0.85); /* keeps footer text/links readable over the SVG */
}
footer > * { position: relative; z-index: 1; } /* lifts content above the ::before overlay */

.footer-top { padding: 56px 0 40px; display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 32px; }
.footer-brand-col .flogo { font-weight: 800; letter-spacing: 0.05em; font-size: 20px; margin-bottom: 12px; }
.footer-brand-col p { color: rgba(253,253,248,0.6); font-size: 13px; max-width: 240px; margin-bottom: 20px; }
.footer-social { display: flex; gap: 12px; }
.footer-social a { width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; }
.footer-social svg { width: 15px; height: 15px; fill: var(--white); }
.footer-col span.topic { display: block; font-weight: 700; font-size: 13px; margin-bottom: 14px; color: var(--orange); text-transform: uppercase; letter-spacing: 0.06em; }
.footer-col a { display: block; font-size: 13px; opacity: 0.8; margin-bottom: 10px; }
.footer-col .contact-line { display: block; font-size: 13px; opacity: 0.8; margin-bottom: 10px; }
.footer-map { margin-top: 8px; border-radius: 14px; overflow: hidden; border: 1px solid rgba(255,255,255,0.12); }
.footer-map iframe { display: block; width: 100%; height: 220px; border: 0; }
.footer-bottom { border-top: 1px solid rgba(255,255,255,0.12); padding: 20px 0; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 12.5px; color: rgba(253,253,248,0.6); }

  @media (max-width: 800px) {
    .footer-top { grid-template-columns: 1fr; }
    footer { background-size: 200% auto; background-position: center top; }
  }
</style>
