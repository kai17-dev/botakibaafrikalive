<body class="va-page">

<!-- ================================================================
     HEADER
     ================================================================ -->
<header>
  <div class="header-inner">
    <a href="/" class="brandmark1" aria-label="Botaki Ba Afrika">
    <img src="/BBALogoWhite.svg" alt="Botaki Ba Afrika" width="100" height="90" />
    </a>
    <nav>
      <div class="nav-links">
        <a href="/" class="nav-link">Home</a>
        <a href="/disciplines" class="nav-link">Disciplines</a>
        <a href="/about" class="nav-link">About</a>
        <!--<div class="nav-item">
          <a href="#projects" class="nav-link">Projects <span class="caret"></span></a>
          <div class="nav-dropdown">
            <a href="#projects">Art Projects</a>
            <a href="#artist">Artists</a>
          </div>
        </div>
        <a href="./bloG.html" class="nav-link">Blog</a>
