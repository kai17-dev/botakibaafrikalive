<!-- ================================================================
     SCRIPT: Art Projects Slideshow + Modal
     ================================================================ -->
<script>
(function () {
  const artProjects = [
    { tag: "Mixed Media · 2026", title: "Art Narratives", caption: "A shared canvas turning everyday scenes into colour and form.", description: "A collaborative series where visual artists reworked scenes from daily township life into layered mixed-media pieces. Each work began as a group sketch session before individual artists took it further in their own style." },
    { tag: "Canvas · 2026", title: "Gallery Wall Series", caption: "A rotating wall installation built collectively over weeks.", description: "Built piece by piece over several weekly sessions, this installation reflects the collective's approach to visual art: no single artist owns the final work, and every contributor leaves a mark on the next person's canvas." },
    { tag: "Performance · 2026", title: "Live Sessions Archive", caption: "Documenting music sessions as visual storytelling.", description: "A visual record of the collective's live performances, treating the stage itself as part of the artwork — lighting, movement, and crowd energy captured alongside the music." },
    { tag: "Photography · 2021", title: "Spoken Word Portraits", caption: "Faces and words from the poetry sessions.", description: "A photo series taken during open-mic poetry nights, pairing portraits of performers with fragments of the lines they read aloud that evening." },
    { tag: "Mixed Media · 2026", title: "Art Narratives", caption: "A shared canvas turning everyday scenes into colour and form.", description: "A collaborative series where visual artists reworked scenes from daily township life into layered mixed-media pieces. Each work began as a group sketch session before individual artists took it further in their own style." },
    { tag: "Canvas · 2026", title: "Gallery Wall Series", caption: "A rotating wall installation built collectively over weeks.", description: "Built piece by piece over several weekly sessions, this installation reflects the collective's approach to visual art: no single artist owns the final work, and every contributor leaves a mark on the next person's canvas." },
    { tag: "Performance · 2026", title: "Live Sessions Archive", caption: "Documenting music sessions as visual storytelling.", description: "A visual record of the collective's live performances, treating the stage itself as part of the artwork — lighting, movement, and crowd energy captured alongside the music." },
    { tag: "Photography · 2021", title: "Spoken Word Portraits", caption: "Faces and words from the poetry sessions.", description: "A photo series taken during open-mic poetry nights, pairing portraits of performers with fragments of the lines they read aloud that evening." },
    { tag: "Mixed Media · 2026", title: "Art Narratives", caption: "A shared canvas turning everyday scenes into colour and form.", description: "A collaborative series where visual artists reworked scenes from daily township life into layered mixed-media pieces. Each work began as a group sketch session before individual artists took it further in their own style." },
    { tag: "Canvas · 2026", title: "Gallery Wall Series", caption: "A rotating wall installation built collectively over weeks.", description: "Built piece by piece over several weekly sessions, this installation reflects the collective's approach to visual art: no single artist owns the final work, and every contributor leaves a mark on the next person's canvas." }
  ];

  const track = document.getElementById('artSlideshowTrack');
  const dots = document.querySelectorAll('#artSlideshowDots .art-dot');
  const slideEls = document.querySelectorAll('.art-slide');
  const captionTitle = document.getElementById('artCaptionTitle');
  const captionText = document.getElementById('artCaptionText');
  const total = dots.length;
  let index = 0;
  let timer;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function goTo(i) {
    index = i;
    track.style.transform = 'translateX(-' + (index * (100 / total)) + '%)';
    dots.forEach((d, di) => d.classList.toggle('active', di === index));
    captionTitle.textContent = artProjects[index].title;
    captionText.textContent = artProjects[index].caption;
  }

  function next() { goTo((index + 1) % total); }

  function startAuto() {
    clearInterval(timer);
    if (!reducedMotion) timer = setInterval(next, 3000);
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', (e) => { e.stopPropagation(); goTo(i); startAuto(); });
  });

  slideEls.forEach((slide, i) => {
    slide.addEventListener('click', () => openArtModal(i));
  });

  goTo(0);
  startAuto();

  // Modal
  const modalOverlay = document.getElementById('art-modal-overlay');
  const modalClose = document.getElementById('art-modal-close');
  const modalImg = document.getElementById('art-modal-image');
  const modalEyebrow = document.getElementById('art-modal-eyebrow');
  const modalTitle = document.getElementById('art-modal-title');
  const modalDesc = document.getElementById('art-modal-desc');

  function openArtModal(i) {
    const p = artProjects[i];
    const imgEl = slideEls[i].querySelector('img');
    modalImg.src = imgEl.src;
    modalImg.alt = imgEl.alt;
    modalEyebrow.textContent = p.tag;
    modalTitle.textContent = p.title;
    modalDesc.textContent = p.description;
    modalOverlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    clearInterval(timer);
  }
  function closeArtModal() {
    modalOverlay.classList.remove('is-open');
    document.body.style.overflow = '';
    startAuto();
  }
  modalClose.addEventListener('click', closeArtModal);
  modalOverlay.addEventListener('click', (e) => { if (e.target === modalOverlay) closeArtModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modalOverlay.classList.contains('is-open')) closeArtModal(); });
})();
</script>

<!-- ================================================================
     SCRIPT: Donate Modal
     ================================================================ -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  const donateBtn = document.querySelector('.nav-d[href="#donate"]');
  const donateModal = document.getElementById('donate-modal-overlay');
  const closeDonateBtn = document.getElementById('donate-modal-close');

  // Open modal when clicking the header "Donate" button
  donateBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    donateModal?.classList.add('is-open');
  });

  // Close modal handlers
  const closeDonateModal = () => donateModal?.classList.remove('is-open');
  closeDonateBtn?.addEventListener('click', closeDonateModal);
  donateModal?.addEventListener('click', (e) => {
    if (e.target === donateModal) closeDonateModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && donateModal?.classList.contains('is-open')) {
      closeDonateModal();
    }
  });

  // Tab switching inside Donate Modal
  const donateTabs = document.querySelectorAll('.donate-tab');
  const donatePanels = document.querySelectorAll('.donate-panel');
  donateTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      donateTabs.forEach(t => t.classList.remove('active'));
      donatePanels.forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      const targetId = tab.getAttribute('data-donate-target');
      document.getElementById(targetId)?.classList.add('active');
    });
  });

  // "Arrange a drop-off" — copy email as fallback if no default mail app is set
  const dropoffBtn = document.getElementById('dropoff-btn');
  const dropoffFeedback = document.getElementById('dropoff-feedback');
  dropoffBtn?.addEventListener('click', () => {
    if (navigator.clipboard) {
      navigator.clipboard.writeText('info@botakibaafrika.org.za').catch(() => {});
    }
    if (dropoffFeedback) {
      dropoffFeedback.style.display = 'block';
      setTimeout(() => { dropoffFeedback.style.display = 'none'; }, 4000);
    }
  });
});
</script>

