.testimonial-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.t-card { background: var(--white); border-radius: 14px; padding: 22px; }
.t-card p.quote { font-weight: 700; font-size: 14.5px; margin-bottom: 20px; }
.t-person { display: flex; align-items: center; gap: 10px; }
.avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--card-gray); flex-shrink: 0; }
.t-person .name { font-size: 13px; font-weight: 700; }
.t-person .desc { font-size: 12px; color: var(--muted); }

/* ============================================================
   NEWSLETTER (currently unused / commented out in HTML)
   ============================================================ */
