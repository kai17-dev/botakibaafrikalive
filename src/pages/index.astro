<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Botaki Ba Afrika</title>
<style>
@font-face {
  font-family: 'Lemon Milk';
  src: url('/fonts/LemonMilk.woff2') format('woff2'),
       url('/fonts/LemonMilk.woff') format('woff');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Lemon Milk';
  src: url('/fonts/LemonMilk-Bold.woff2') format('woff2'),
       url('/fonts/LemonMilk-Bold.woff') format('woff');
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Lemon Milk';
  src: url('/fonts/LemonMilk-ExtraBold.woff2') format('woff2'),
       url('/fonts/LemonMilk-ExtraBold.woff') format('woff');
  font-weight: 800;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Avernire Medium';
  src: url('/fonts/Avernire-Medium.woff2') format('woff2'),
       url('/fonts/Avernire-Medium.woff') format('woff');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

:root {
  --cream: #EEF0C4;
  --yellow: #F3B417;
  --orange: #E97C2C;
  --brown: #5A2A0C;
  --green: #163C0A;
  --ink: #171512;
  --muted: #6B6858;
  --card-gray: #C9C9C4;
  --white: #FDFDF8;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { font-family: 'Avernire Medium', Arial, sans-serif; background: var(--cream); color: var(--ink); line-height: 1.5; }
h1, h2, h3, h4, h5, h6 { font-family: 'Lemon Milk', Arial, sans-serif; }
a { color: inherit; text-decoration: none; }
img, .ph { display: block; }
.wrap { max-width: 1100px; margin: 0 auto; padding: 0 32px; }
button { font-family: inherit; }

/* ---------- HEADER ---------- */
header { background: var(--ink); position: sticky; top: 0; z-index: 50; }
.header-inner { max-width: 1100px; margin: 0 auto; padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; position: relative; }
.brandmark { width: 64px; height: 64px; display: flex; align-items: center; justify-content: center;}
.brandmark img { width: 64px; height: 64px;}
.nav-links { display: flex; align-items: center; gap: 26px; }
.nav-link { color: var(--white); font-size: 13px; letter-spacing: 0.08em; font-weight: 600; text-transform: uppercase; display: flex; align-items: center; gap: 5px; }
.nav-cta { background: var(--white); color: var(--ink); padding: 10px 18px; border-radius: 999px; font-size: 12px; letter-spacing: 0.06em; font-weight: 700; text-transform: uppercase; }
.menu-toggle { display: none; background: none; border: none; color: var(--white); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; }



nav { display: flex; align-items: center; gap: 18px; }
.nav-links { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }


/* Dropdown sub-nav (Twinbru-style flyout under nav items) */
.nav-item { position: relative; }
.nav-item .caret { width: 6px; height: 6px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); margin-top: -3px; transition: transform 0.2s ease; }
.nav-item:hover .caret, .nav-item.open .caret { transform: rotate(225deg); margin-top: 3px; }
.nav-dropdown {
  position: absolute; top: 100%; left: 0; margin-top: 16px;
  background: var(--white); color: var(--ink); border-radius: 12px; padding: 10px;
  min-width: 180px; box-shadow: 0 12px 30px rgba(0,0,0,0.18);
  opacity: 0; visibility: hidden; transform: translateY(8px);
  transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
}
.nav-item:hover .nav-dropdown, .nav-item.open .nav-dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
.nav-dropdown a { display: block; padding: 8px 12px; border-radius: 8px; font-size: 13px; font-weight: 600; text-transform: none; letter-spacing: 0; color: var(--ink); }
.nav-dropdown a:hover { background: var(--cream); }

@media (max-width: 800px) {
  .nav-links {
    display: none; position: absolute; top: 100%; left: 0; right: 0;
    background: var(--ink); flex-direction: column; align-items: flex-start;
    padding: 20px 32px; gap: 4px;
  }
  .nav-links.nav-open { display: flex; }
  .nav-item { width: 100%; }
  .nav-item .nav-link { width: 100%; padding: 10px 0; justify-content: space-between; }
  .nav-dropdown { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; background: rgba(255,255,255,0.06); width: 100%; margin: 0 0 8px; }
  .nav-dropdown a { color: var(--white); }
  .nav-dropdown a:hover { background: rgba(255,255,255,0.1); }
}

/* ---------- HERO (Twinbru-style: heading, subcopy, full-width media, marquee strip) ---------- */
.hero { padding: 72px 0 0; }
.hero-inner { text-align: center; max-width: 720px; margin: 0 auto 40px; }
.hero-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--orange); margin-bottom: 16px; }
h1.title { font-size: clamp(36px, 6vw, 58px); font-weight: 800; letter-spacing: -0.01em; margin-bottom: 20px; }
.tagline { font-size: 17px; color: var(--muted); max-width: 480px; margin: 0 auto; }
.hero-media { width: 100%; aspect-ratio: 16/7; background: var(--card-gray); border-radius: 18px; margin-bottom: 8px; }

.marquee-strip { overflow: hidden; padding: 28px 0; border-top: 1px solid rgba(23,21,18,0.08); border-bottom: 1px solid rgba(23,21,18,0.08); margin-top: 32px; }
.marquee-track { display: flex; width: max-content; gap: 14px; animation: marquee 22s linear infinite; }
.marquee-track.reverse { animation-direction: reverse; margin-top: 14px; }
.marquee-track span { flex-shrink: 0; padding: 10px 22px; border-radius: 999px; font-size: 13px; font-weight: 700; color: var(--white); }
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }

/* ---------- SHARED SECTION STYLES ---------- */
.section { padding: 64px 0; }
.eyebrow { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--orange); margin-bottom: 12px; }
.section h2.heading { font-size: 30px; font-weight: 800; max-width: 560px; margin-bottom: 12px; }
.section .lede { color: var(--muted); font-size: 15px; max-width: 480px; margin-bottom: 32px; }
.ph { background: var(--card-gray); border-radius: 18px; width: 100%; aspect-ratio: 16/11; }

/* ---------- USE CASES (numbered pill tabs) ---------- */
.uc-tabs { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 32px; }
.uc-tab { padding: 10px 20px; border-radius: 999px; border: 1px solid rgba(23,21,18,0.15); background: transparent; font-size: 13px; font-weight: 700; cursor: pointer; transition: 0.2s ease; color: var(--ink); }
.uc-tab.active { background: var(--ink); color: var(--white); border-color: var(--ink); }
.uc-panel { display: none; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: center; }
.uc-panel.active { display: grid; }
.uc-copy h3 { font-size: 22px; font-weight: 800; margin-bottom: 10px; }
.uc-copy p { color: var(--muted); font-size: 14.5px; max-width: 340px; }
.uc-image { aspect-ratio: 4/3; }
@media (max-width: 800px) { .uc-panel { grid-template-columns: 1fr; } }

/* ---------- NEXT EVENT / HELP GUIDE CTA ---------- */
.event-grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: 40px; align-items: center; }
.event-copy h3 { font-size: 15px; font-weight: 700; margin-bottom: 8px; }
.event-copy p { color: var(--muted); font-size: 14.5px; max-width: 280px; margin-bottom: 20px; }
.event-media .ph { aspect-ratio: 1/1; max-width: 340px; }
.btn { padding: 12px 22px; border-radius: 999px; font-size: 13px; font-weight: 700; border: none; cursor: pointer; display: inline-block; }
.btn-primary { background: var(--ink); color: var(--white); }
.btn-secondary { background: #E3E3DA; color: var(--ink); }
.btn-row { display: flex; gap: 12px; }


/* ---------- BIG STATEMENT BAND (full-bleed image + overlay heading) ---------- */
.big-statement { position: relative; min-height: 340px; border-radius: 0; overflow: hidden; background: var(--brown); display: flex; align-items: center; justify-content: center; text-align: center; }
.big-statement::before { content:""; position:absolute; inset:0; background: linear-gradient(120deg, rgba(23,21,18,0.55), rgba(23,21,18,0.25)); }
.big-statement-inner { position: relative; z-index: 1; max-width: 640px; padding: 0 32px; }
.big-statement-inner .eyebrow { color: var(--yellow); }
.big-statement-inner h2 { font-size: 34px; font-weight: 800; color: var(--white); }

/* ---------- NEWSLETTER ---------- */
.newsletter { background: var(--white); }
.newsletter-inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px; }
.newsletter-copy h2 { font-size: 24px; font-weight: 800; margin-bottom: 8px; }
.newsletter-copy p { color: var(--muted); font-size: 14px; max-width: 380px; }
.newsletter-form { display: flex; gap: 10px; }
.newsletter-form input { padding: 12px 18px; border-radius: 999px; border: 1px solid rgba(23,21,18,0.2); font-size: 13px; min-width: 220px; }

/* ---------- ART PROJECTS ---------- */
.projects-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
.project-card .ph { aspect-ratio: 4/3; margin-bottom: 16px; }
.project-card h3 { font-size: 15px; font-weight: 700; margin-bottom: 6px; }
.project-card p { color: var(--muted); font-size: 14px; max-width: 300px; }

/* ---------- TESTIMONIALS ---------- */
.testimonial-label { color: var(--muted); font-size: 26px; font-weight: 800; text-transform: uppercase; margin-bottom: 24px; }
.testimonial-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.t-card { background: var(--white); border-radius: 14px; padding: 22px; }
.t-card p.quote { font-weight: 700; font-size: 14.5px; margin-bottom: 20px; }
.t-person { display: flex; align-items: center; gap: 10px; }
.avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--card-gray); flex-shrink: 0; }
.t-person .name { font-size: 13px; font-weight: 700; }
.t-person .desc { font-size: 12px; color: var(--muted); }

/* ---------- CTA BAND ---------- */
.cta-band { background: var(--white); padding: 48px 0; }
.cta-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; }
.cta-inner h2 { font-size: 30px; font-weight: 800; }

/* ---------- FOOTER ---------- */
footer { background: var(--ink); color: var(--white); }
.footer-top { padding: 56px 0 40px; display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 32px; }
.footer-brand-col .flogo { font-weight: 800; letter-spacing: 0.05em; font-size: 20px; margin-bottom: 12px; }
.footer-brand-col p { color: rgba(253,253,248,0.6); font-size: 13px; max-width: 240px; margin-bottom: 20px; }
.footer-social { display: flex; gap: 12px; }
.footer-social a { width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; }
.footer-social svg { width: 15px; height: 15px; fill: var(--white); }
.footer-col span.topic { display: block; font-weight: 700; font-size: 13px; margin-bottom: 14px; color: var(--yellow); text-transform: uppercase; letter-spacing: 0.06em; }
.footer-col a { display: block; font-size: 13px; opacity: 0.8; margin-bottom: 10px; }
.footer-col .contact-line { display: block; font-size: 13px; opacity: 0.8; margin-bottom: 10px; }
.footer-map { margin-top: 8px; border-radius: 14px; overflow: hidden; border: 1px solid rgba(255,255,255,0.12); }
.footer-map iframe { display: block; width: 100%; height: 220px; border: 0; }
.footer-bottom { border-top: 1px solid rgba(255,255,255,0.12); padding: 20px 0; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 12.5px; color: rgba(253,253,248,0.6); }

/* ---------- RESPONSIVE ---------- */
@media (max-width: 900px) { .ic-grid { grid-template-columns: repeat(2,1fr); } .footer-top { grid-template-columns: 1fr 1fr; } }
@media (max-width: 800px) {
  .menu-toggle { display: block; }
  .event-grid, .how-grid, .projects-grid, .newsletter-inner { grid-template-columns: 1fr !important; }
  .testimonial-grid { grid-template-columns: 1fr; }
  .cta-inner { flex-direction: column; align-items: flex-start; }
}
@media (max-width: 520px) { .ic-grid { grid-template-columns: 1fr; } .ic-wrap { aspect-ratio: 4/5; } .footer-top { grid-template-columns: 1fr; } }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
a:focus-visible, button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

/* ---------- Modal ---------- */
  .event-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(23, 15, 5, 0.65);
    backdrop-filter: blur(3px);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .event-modal-overlay.is-open {
    display: flex;
  }

  .event-modal {
    position: relative;
    background: var(--cream, #EEF0C4);
    border: 3px solid var(--brown, #5A2A0C);
    border-radius: 16px;
    max-width: 460px;
    width: 100%;
    padding: 32px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.35);
    animation: event-modal-pop 0.25s ease;
  }

  @keyframes event-modal-pop {
    from { opacity: 0; transform: scale(0.95) translateY(8px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .event-modal-close {
    position: absolute;
    top: 12px;
    right: 16px;
    background: none;
    border: none;
    font-size: 28px;
    line-height: 1;
    color: var(--brown, #5A2A0C);
    cursor: pointer;
  }

  .event-modal-eyebrow {
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 13px;
    color: var(--orange, #E97C2C);
    margin-bottom: 8px;
  }

  .event-modal h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 26px;
    margin: 0 0 4px;
    color: var(--brown, #5A2A0C);
  }

  .event-modal-artist {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 20px;
    color: var(--brown, #5A2A0C);
  }

  .event-modal-artist span {
    font-weight: 400;
    opacity: 0.8;
  }

  .event-modal-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 16px;
    font-size: 14px;
  }

  .event-modal-label {
    font-weight: 700;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--green, #163C0A);
  }

  .event-modal-value {
    color: var(--brown, #5A2A0C);
    line-height: 1.4;
  }

  .event-modal-cta {
    display: block;
    text-align: center;
    margin-top: 24px;
    width: 100%;
  }

</style>

