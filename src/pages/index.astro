<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Botaki Ba Afrika</title>
<style>

/* ============================================================
   FONTS
   ============================================================ */
@font-face {
  font-family: 'Lemon Milk';
  src: url('/fonts/LemonMilk.woff2') format('woff2'),
       url('/fonts/LemonMilk.woff') format('woff');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Lemon Milk';
  src: url('/fonts/LemonMilk-Bold.woff2') format('woff2'),
       url('/fonts/LemonMilk-Bold.woff') format('woff');
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Lemon Milk';
  src: url('/fonts/LemonMilk-ExtraBold.woff2') format('woff2'),
       url('/fonts/LemonMilk-ExtraBold.woff') format('woff');
  font-weight: 800;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Avernire Medium';
  src: url('/fonts/Avernire-Medium.woff2') format('woff2'),
       url('/fonts/Avernire-Medium.woff') format('woff');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

/* ============================================================
   ROOT VARIABLES + BASE / RESET
   ============================================================ */
:root {
  --cream: #EEF0C4;
  --yellow: #F3B417;
  --orange: #E97C2C;
  --brown: #5A2A0C;
  --green: #163C0A;
  --ink: #171512;
  --muted: #6B6858;
  --card-gray: #C9C9C4;
  --white: #FFFFFF;
  --black: #1a1a1a;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
html, body { overflow-x: hidden; }
body { font-family: 'Avernire Medium', Arial, sans-serif; background: var(--white); color: var(--ink); line-height: 1.5; }
h1, h2, h3, h4, h5, h6 { font-family: 'Lemon Milk', Arial, sans-serif; }
a { color: inherit; text-decoration: none; }
img, .ph { display: block; }
button { font-family: inherit; }
.wrap { max-width: 1100px; margin: 0 auto; padding: 0 32px; }
.btn { padding: 12px 22px; border-radius: 999px; font-size: 13px; font-weight: 700; border: none; cursor: pointer; display: inline-block; }
.btn-primary { background: var(--ink); color: var(--white); }
.btn-secondary { background: #E3E3DA; color: var(--ink); }
.btn-row { display: flex; gap: 12px; }
a:focus-visible, button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

/* ============================================================
   HEADER / NAVIGATION
 ============================================================ */
header { background: var(--ink); position: sticky; top: 0; z-index: 50; }
.header-inner { max-width: 1100px; margin: 0 auto; padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; position: relative; }
.brandmark { width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; }
.brandmark img { width: 64px; height: 64px; }

nav { display: flex; align-items: center; gap: 18px; }
.nav-links { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
.nav-link { color: var(--white); font-size: 13px; letter-spacing: 0.08em; font-weight: 600; text-transform: uppercase; display: flex; align-items: center; gap: 5px; }
.nav-cta { background: var(--white); color: var(--ink); padding: 10px 18px; border-radius: 999px; font-size: 12px; letter-spacing: 0.06em; font-weight: 700; text-transform: uppercase; }
.nav-d { background: var(--orange); color: var(--white); padding: 10px 18px; border-radius: 999px; font-size: 12px; letter-spacing: 0.06em; font-weight: 700; text-transform: uppercase; }
.menu-toggle { display: none; background: none; border: none; color: var(--white); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; }

/* Dropdown sub-nav (Twinbru-style flyout under nav items) */
.nav-item { position: relative; }
.nav-item .caret { width: 6px; height: 6px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); margin-top: -3px; transition: transform 0.2s ease; }
.nav-item:hover .caret, .nav-item.open .caret { transform: rotate(225deg); margin-top: 3px; }
.nav-dropdown {
  position: absolute; top: 100%; left: 0; margin-top: 16px;
  background: var(--white); color: var(--ink); border-radius: 12px; padding: 10px;
  min-width: 180px; box-shadow: 0 12px 30px rgba(0,0,0,0.18);
  opacity: 0; visibility: hidden; transform: translateY(8px);
  transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
}
.nav-item:hover .nav-dropdown, .nav-item.open .nav-dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
.nav-dropdown a { display: block; padding: 8px 12px; border-radius: 8px; font-size: 13px; font-weight: 600; text-transform: none; letter-spacing: 0; color: var(--ink); }
.nav-dropdown a:hover { background: var(--cream); }

/* Header — mobile */
@media (max-width: 800px) {
   .nav-links {
    display: none; position: absolute; top: 100%; left: 0; right: 0;
    background: var(--ink); flex-direction: column; align-items: flex-start;
    padding: 20px 32px; gap: 4px;
  }
  .nav-links.nav-open { display: flex; }
  .nav-item { width: 100%; }
  .nav-item .nav-link { width: 100%; padding: 10px 0; justify-content: space-between; }
  .nav-dropdown { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; background: rgba(255,255,255,0.06); width: 100%; margin: 0 0 8px; }
  .nav-dropdown a { color: var(--white); }
  .nav-dropdown a:hover { background: rgba(255,255,255,0.1); }
  .header-inner { padding: 14px 16px; }
  nav { gap: 8px; }
  .nav-cta, .nav-d { padding: 8px 12px; font-size: 10.5px; letter-spacing: 0.04em; }
  .menu-toggle { display: block; font-size: 11px; margin-left: 2px; }
  .btn { padding: 10px 16px; font-size: 12px; }
  .btn-row { flex-wrap: wrap; }
}

/* ============================================================
   HERO
   ============================================================ */
.hero {
  padding: 100px 0;
  background-color: var(--white);
  background-image: url("/Resources/Backgrounds/Main%20BG%20Orange.svg");
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover;
}
.hero-inner { text-align: center; max-width: 720px; margin: 0 auto 40px; }
.hero-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--orange); margin-bottom: 16px; }
h1.title { font-size: clamp(36px, 6vw, 58px); font-weight: 800; letter-spacing: -0.01em; margin-bottom: 20px; }
.tagline { font-size: 17px; color: var(--muted); max-width: 480px; margin: 0 auto; }
.hero-logo {
  max-width: 340px;
  width: 60%;
  height: auto;
  margin: 0 auto 20px;
}
@media (max-width: 800px) {
  .hero-logo { max-width: 220px; }
}

.hero-media { width: 100%; aspect-ratio: 16/7; background: var(--card-gray); border-radius: 0; margin-bottom: 8px; overflow: hidden; }
.hero-media video { width: 100%; height: 100%; object-fit: cover; display: block; }

/* ============================================================
   SPONSORS MARQUEE
   ============================================================ */
.marquee-strip { overflow: hidden; padding: 36px 0; border-top: 1px solid rgba(23,21,18,0.08); border-bottom: 1px solid rgba(23,21,18,0.08); margin-top: 32px; }
.marquee-label { text-align: center; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 18px; }
.marquee-track { display: flex; width: max-content; gap: 80px; align-items: center; animation: marquee 28s linear infinite; }
.marquee-track:hover { animation-play-state: paused; }
.sponsor-logo { flex-shrink: 0; height: 80px; max-width: 220px; display: flex; align-items: center; justify-content: center; }
.sponsor-logo img { max-height: 100%; max-width: 100%; width: auto; height: auto; object-fit: contain; filter: grayscale(100%); opacity: 0.65; transition: filter 0.2s ease, opacity 0.2s ease; }
.sponsor-logo img:hover { filter: grayscale(0%); opacity: 1; }
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }

/* ============================================================
   SHARED SECTION STYLES (used by disciplines, event, etc.)
   ============================================================ */
.section { padding: 64px 0; }
.eyebrow { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--orange); margin-bottom: 12px; }
.section h2.heading { font-size: 30px; font-weight: 800; max-width: 560px; margin-bottom: 12px; }
.section .lede { color: var(--muted); font-size: 15px; max-width: 480px; margin-bottom: 32px; }
.ph { background: var(--card-gray); border-radius: 18px; width: 100%; aspect-ratio: 16/11; }

/* ============================================================
   DISCIPLINES (numbered pill tabs)
   ============================================================ */
.uc-tabs { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 32px; }
.uc-tab { padding: 10px 20px; border-radius: 999px; border: 1px solid rgba(23,21,18,0.15); background: transparent; font-size: 13px; font-weight: 700; cursor: pointer; transition: 0.2s ease; color: var(--ink); }
.uc-tab.active { background: var(--ink); color: var(--white); border-color: var(--ink); }

.uc-panel {
  display: none;
  grid-template-columns: 0.9fr 1.3fr; /* text column narrower, image column wider */
  gap: 56px;
  align-items: center;
}
.uc-panel.active { display: grid; }
.uc-copy h3 { font-size: 22px; font-weight: 800; margin-bottom: 10px; }
.uc-copy p { color: var(--muted); font-size: 14.5px; max-width: 380px; }

.uc-image {
  width: 100%;
  height: 100%;
  aspect-ratio: 16/11;
  object-fit: cover;
  border-radius: 0;
}

@media (max-width: 800px) {
  .uc-panel { grid-template-columns: 1fr; gap: 24px; }
  .uc-image { aspect-ratio: 4/3; }
}

/* ============================================================
   UPCOMING EVENTS — 6-panel clickable grid
   ============================================================ */
.evg-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}
.evg-panel {
  position: relative;
  aspect-ratio: 1 / 1;
  min-height: 340px;
  border-radius: 16px;
  overflow: hidden;
  cursor: pointer;
  background-color: var(--card-gray);
  box-shadow: 0 6px 16px rgba(23,21,18,0.12);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.evg-panel:hover { transform: translateY(-6px); box-shadow: 0 18px 36px rgba(23,21,18,0.3); }

.evg-panel-img {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  transition: transform 0.5s ease;
}
.evg-panel:hover .evg-panel-img { transform: scale(1.08); }

.evg-panel-overlay {
  position: absolute;
  inset: 0;
  transition: background 0.35s ease;
}

/* Event 1 — Ditiragalo Tsa Mmino */
.evg-panel:nth-child(1) .evg-panel-overlay { background: linear-gradient(to top, rgba(243,180,23,0.9) 0%, rgba(243,180,23,0.4) 45%, rgba(243,180,23,0.05) 75%); }
/* Event 2 — Art Exhibition Opening */
.evg-panel:nth-child(2) .evg-panel-overlay { background: linear-gradient(to top, rgba(233,124,44,0.9) 0%, rgba(233,124,44,0.4) 45%, rgba(233,124,44,0.05) 75%); }
/* Event 3 — Poetry & Literature Evening */
.evg-panel:nth-child(3) .evg-panel-overlay { background: linear-gradient(to top, rgba(22,60,10,0.9) 0%, rgba(22,60,10,0.4) 45%, rgba(22,60,10,0.05) 75%); }
/* Event 4 — Crafts Market Day */
.evg-panel:nth-child(4) .evg-panel-overlay { background: linear-gradient(to top, rgba(90,42,12,0.9) 0%, rgba(90,42,12,0.4) 45%, rgba(90,42,12,0.05) 75%); }
/* Event 5 — Community Workshop */
.evg-panel:nth-child(5) .evg-panel-overlay { background: linear-gradient(to top, rgba(238,240,196,0.92) 0%, rgba(238,240,196,0.45) 45%, rgba(238,240,196,0.08) 75%); }
/* Event 6 — Cultural Festival */
.evg-panel:nth-child(6) .evg-panel-overlay { background: linear-gradient(to top, rgba(23,21,18,0.88) 0%, rgba(23,21,18,0.4) 40%, rgba(23,21,18,0.05) 70%); }

.evg-panel:hover .evg-panel-overlay { filter: brightness(0.9); }

.evg-panel-content { position: absolute; bottom: 0; left: 0; right: 0; padding: 20px; z-index: 1; }
.evg-panel-title {
  color: var(--ink);
  font-size: 19px;
  font-weight: 800;
  margin-bottom: 4px;
  line-height: 1.2;
  transition: color 0.3s ease;
}
.evg-panel-date {
  color: var(--brown);
  font-size: 13px;
  font-weight: 700;
  transition: color 0.3s ease;
}
.evg-panel:hover .evg-panel-title,
.evg-panel:hover .evg-panel-date {
  color: var(--white);
}
.evg-panel:nth-child(5):hover .evg-panel-title,
.evg-panel:nth-child(5):hover .evg-panel-date {
  color: var(--ink);
}

@media (max-width: 900px) {
  .evg-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .evg-panel { min-height: 300px; }
}
@media (max-width: 520px) {
  .evg-grid { grid-template-columns: 1fr; }
  .evg-panel { aspect-ratio: 4 / 3; min-height: 260px; }
}

/* Event modal */
.evg-modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(23, 15, 5, 0.65);
  backdrop-filter: blur(3px);
  z-index: 1000;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.evg-modal-overlay.is-open { display: flex; }
.evg-modal {
  position: relative;
  background-color: var(--white);
  background-image: url("/Resources/Info%20Tab%20Bg%20Design/Design%201.svg");
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover;
  border: 3px solid var(--white);
  border-radius: 16px;
  max-width: 460px;
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  box-shadow: 0 20px 50px rgba(0,0,0,0.35);
  animation: event-modal-pop 0.25s ease;
}
@keyframes event-modal-pop {
  from { opacity: 0; transform: scale(0.95) translateY(8px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}
.evg-modal-inner { padding: 32px; }
.evg-modal-close { position: absolute; top: 12px; right: 16px; background: none; border: none; font-size: 28px; line-height: 1; color: var(--brown); cursor: pointer; z-index: 2; }
.evg-modal-eyebrow { font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; font-size: 13px; color: var(--orange); margin-bottom: 8px; }
.evg-modal h3 { font-size: 26px; margin: 0 0 20px; color: var(--brown); }
.evg-modal-row { display: flex; flex-direction: column; gap: 2px; margin-bottom: 16px; font-size: 14px; }
.evg-modal-label { font-weight: 700; text-transform: uppercase; font-size: 11px; letter-spacing: 0.04em; color: var(--green); }
.evg-modal-value { color: var(--brown); line-height: 1.4; }
.evg-modal-desc { color: var(--brown); font-size: 14px; line-height: 1.55; margin-bottom: 16px; opacity: 0.9; }
.evg-modal-cta { display: block; text-align: center; margin-top: 8px; width: 100%; }

/* ============================================================
   BIG STATEMENT BAND
   ============================================================ */
.big-statement {
  position: relative;
  min-height: 340px;
  border-radius: 0;
  overflow: hidden;
  background-color: var(--black);
  background-image: url("/Resources/Backgrounds/Banner%20BG%20Orange.svg");
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.big-statement::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(26, 26, 26, 0.75); /* translucent so the SVG shows through */
}
.big-statement-inner { position: relative; z-index: 1; max-width: 640px; padding: 0 32px; }
.big-statement-inner .eyebrow { color: var(--orange); }
.big-statement-inner h2 { font-size: 34px; font-weight: 800; color: var(--white); }

/* ============================================================
   ART PROJECTS SLIDESHOW
   ============================================================ */
#projects {
  background-color: var(--white);
  background-image: url("/Resources/Backgrounds/Art%20Projects%20BG%20Orange%201.svg");
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover;
}
.art-slideshow {
  position: relative;
  max-width: 640px;
  margin: 0 auto;
  border-radius: 18px;
  overflow: hidden;
  aspect-ratio: 16/10;
  background: var(--card-gray);
  cursor: pointer;
}
.art-slideshow-track { display: flex; width: 1000%; height: 100%; transition: transform 0.6s ease; }
.art-slide { width: 10%; flex-shrink: 0; position: relative; overflow: hidden; }
.art-slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
.art-slideshow-dots { position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; max-width: 90%; }
.art-slideshow-dots .art-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(253,253,248,0.7); border: none; cursor: pointer; padding: 0; transition: width 0.2s ease, background 0.2s ease; }
.art-slideshow-dots .art-dot.active { background: var(--white); width: 20px; border-radius: 999px; }
.art-slide-caption { text-align: center; margin-top: 18px; }
.art-slide-caption h3 { font-size: 16px; font-weight: 700; margin-bottom: 4px; }
.art-slide-caption p { color: var(--muted); font-size: 13.5px; max-width: 480px; margin: 0 auto; }
@media (prefers-reduced-motion: reduce) { .art-slideshow-track { transition: none; } }

/* Hover overlay on each slide */
.art-slide-overlay {
  position: absolute;
  inset: 0;
  background-color: rgba(23, 21, 18, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
  z-index: 2;
}
.art-slide-overlay span {
  color: var(--white);
  font-family: 'Lemon Milk', Arial, sans-serif;
  font-size: 14px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.art-slide:hover .art-slide-overlay { opacity: 1; visibility: visible; }

/* Art modal (shares Design 2 background) */
.art-modal-overlay { display: none; position: fixed; inset: 0; background: rgba(23,15,5,0.65); backdrop-filter: blur(3px); z-index: 1000; align-items: center; justify-content: center; padding: 24px; cursor: pointer; }
.art-modal-overlay.is-open { display: flex; }
.art-modal {
  position: relative;
  background-color: var(--white);
  background-image: url("/Resources/Info%20Tab%20Bg%20Design/Design%202.svg");
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover;
  border: 3px solid var(--brown);
  border-radius: 16px;
  max-width: 640px;
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  box-shadow: 0 20px 50px rgba(0,0,0,0.35);
  animation: event-modal-pop 0.25s ease;
  cursor: default;
}
.art-modal-close { position: absolute; top: 12px; right: 16px; background: none; border: none; font-size: 28px; line-height: 1; color: var(--brown); cursor: pointer; z-index: 2; }
.art-modal-media img { width: 100%; aspect-ratio: 16/10; object-fit: cover; display: block; border-radius: 13px 13px 0 0; }
.art-modal-body { padding: 28px 32px 32px; }
.art-modal-eyebrow { font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; font-size: 13px; color: var(--orange); margin-bottom: 8px; }
.art-modal-body h3 { font-family: 'Space Grotesk', sans-serif; font-size: 24px; margin: 0 0 12px; color: var(--brown); }
.art-modal-desc { color: var(--brown); font-size: 14.5px; line-height: 1.6; opacity: 0.9; }

/* ============================================================
   DONATE MODAL
   ============================================================ */
.donate-modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(23, 15, 5, 0.65);
  backdrop-filter: blur(3px);
  z-index: 1000;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.donate-modal-overlay.is-open { display: flex; }
.donate-modal {
  position: relative;
  background-color: var(--white);
  background-image: url("/Resources/Info%20Tab%20Bg%20Design/Design%201.svg");
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover;
  border: 3px solid var(--white);
  border-radius: 16px;
  max-width: 480px;
  width: 100%;
  padding: 32px;
  box-shadow: 0 20px 50px rgba(0,0,0,0.35);
  animation: event-modal-pop 0.25s ease;
  max-height: 90vh;
  overflow-y: auto;
}
.donate-modal-close { position: absolute; top: 12px; right: 16px; background: none; border: none; font-size: 28px; line-height: 1; color: var(--brown, #5A2A0C); cursor: pointer; }
.donate-modal-eyebrow { font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; font-size: 13px; color: var(--orange, #E97C2C); margin-bottom: 6px; }
.donate-modal h3 { font-family: 'Lemon Milk', Arial, sans-serif; font-size: 24px; margin: 0 0 6px; color: var(--brown, #5A2A0C); }
.donate-modal-subtitle { font-size: 14px; color: var(--muted); margin-bottom: 20px; }

.donate-tabs { display: flex; gap: 8px; margin-bottom: 20px; background: rgba(0, 0, 0, 0.05); padding: 4px; border-radius: 999px; }
.donate-tab { flex: 1; padding: 8px 14px; border-radius: 999px; border: none; background: transparent; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; cursor: pointer; color: var(--ink); transition: all 0.2s ease; }
.donate-tab.active { background: var(--ink); color: var(--white); }

.donate-panel { display: none; }
.donate-panel.active { display: block; }
.donate-info-box { background: rgba(255, 255, 255, 0.85); border: 1px solid rgba(23, 21, 18, 0.1); border-radius: 12px; padding: 16px; margin-bottom: 16px; }
.donate-label { display: block; font-weight: 700; text-transform: uppercase; font-size: 11px; letter-spacing: 0.05em; color: var(--green, #163C0A); margin-bottom: 8px; }
.donate-details { font-size: 13.5px; color: var(--brown, #5A2A0C); line-height: 1.5; }
.donate-desc { font-size: 13px; color: var(--muted); margin-bottom: 10px; }
.donate-list { padding-left: 18px; font-size: 13px; color: var(--ink); }
