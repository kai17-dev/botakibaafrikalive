/* ---------- Modal ---------- */
  .event-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(23, 15, 5, 0.65);
    backdrop-filter: blur(3px);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .event-modal-overlay.is-open {
    display: flex;
  }

.event-modal {
  position: relative;
  
  /* Standard background fallback tone, followed by your custom SVG asset path */
  background-color: var(--white);
  background-image: url("/Resources/Info%20Tab%20Bg%20Design/Design%201.svg");
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover; /* Stretches the SVG design to fill the entire card perfectly */
  
  border: 3px solid var(--white);
  border-radius: 16px;
  max-width: 460px;
  width: 100%;
  padding: 32px;
  box-shadow: 0 20px 50px rgba(0,0,0,0.35);
  animation: event-modal-pop 0.25s ease;
}

  @keyframes event-modal-pop {
    from { opacity: 0; transform: scale(0.95) translateY(8px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .event-modal-close {
    position: absolute;
    top: 12px;
    right: 16px;
    background: none;
    border: none;
    font-size: 28px;
    line-height: 1;
    color: var(--brown, #5A2A0C);
    cursor: pointer;
  }

  .event-modal-eyebrow {
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 13px;
    color: var(--orange, #E97C2C);
    margin-bottom: 8px;
  }

  .event-modal h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 26px;
    margin: 0 0 4px;
    color: var(--brown, #5A2A0C);
  }

  .event-modal-artist {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 20px;
    color: var(--brown, #5A2A0C);
  }

  .event-modal-artist span {
    font-weight: 400;
    opacity: 0.8;
  }

  .event-modal-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 16px;
    font-size: 14px;
  }

  .event-modal-label {
    font-weight: 700;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--green, #163C0A);
  }

  .event-modal-value {
    color: var(--brown, #5A2A0C);
    line-height: 1.4;
  }

  .event-modal-cta {
    display: block;
