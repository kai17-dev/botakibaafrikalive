  <section class="section" id="disciplines">
    <div class="wrap">
      <div class="eyebrow">What we do</div>
      <h2 class="heading">Discover Botaki's disciplines</h2>
      <p class="lede">Three crafts, one collective. Explore what each discipline brings to the group.</p>

      <div class="uc-tabs">
        <button class="uc-tab active" data-target="uc-1">01 Visual Arts</button>
        <button class="uc-tab" data-target="uc-2">02 Music</button>
