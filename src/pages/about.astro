<style>
@font-face {
  font-family: 'Lemon Milk';
  src: url('/fonts/LemonMilk.woff2') format('woff2'),
       url('/fonts/LemonMilk.woff') format('woff');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Lemon Milk';
  src: url('/fonts/LemonMilk-Bold.woff2') format('woff2'),
       url('/fonts/LemonMilk-Bold.woff') format('woff');
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Lemon Milk';
  src: url('/fonts/LemonMilk-ExtraBold.woff2') format('woff2'),
       url('/fonts/LemonMilk-ExtraBold.woff') format('woff');
  font-weight: 800;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Avernire Medium';
  src: url('/fonts/Avernire-Medium.woff2') format('woff2'),
       url('/fonts/Avernire-Medium.woff') format('woff');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

:root {
  --cream: #EEF0C4;
  --yellow: #F3B417;
  --brownxorange: #bd5601;
  --orange: #E97C2C;
  --brown: #5A2A0C;
  --green: #163C0A;
  --ink: #171512;
  --muted: #6B6858;
  --card-gray: #C9C9C4;
  --white: #FFFFFF;
  --black: #1a1a1a;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { font-family: 'Avernire Medium', Arial, sans-serif; background: var(--black); color: var(--white); line-height: 1.5; }
h1, h2, h3, h4, h5, h6 { font-family: 'Lemon Milk', Arial, sans-serif; }
a { color: inherit; text-decoration: none; }
img { display: block; }
.wrap { max-width: 1100px; margin: 0 auto; padding: 0 32px; }
button { font-family: inherit; }

/* ---------- HEADER (shared) ---------- */
header { background: var(--ink); position: sticky; top: 0; z-index: 50; }
.header-inner { max-width: 1100px; margin: 0 auto; padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; position: relative; }
.brandmark { display: flex; align-items: center; justify-content: center; }
.brandmark img { display: block; }
nav { display: flex; align-items: center; gap: 24px; }
.nav-links { display: flex; align-items: center; gap: 26px; }
.nav-link { color: var(--white); font-size: 13px; letter-spacing: 0.08em; font-weight: 600; text-transform: uppercase; }
.nav-link[aria-current="page"] { text-decoration: underline; text-underline-offset: 5px; }
.nav-cta { background: var(--white); color: var(--ink); padding: 10px 18px; border-radius: 999px; font-size: 12px; letter-spacing: 0.06em; font-weight: 700; text-transform: uppercase; }
.nav-d { background: var(--orange); color: var(--white); padding: 10px 18px; border-radius: 999px; font-size: 12px; letter-spacing: 0.06em; font-weight: 700; text-transform: uppercase; }
.menu-toggle { display: none; background: none; border: none; color: var(--white); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; }
@media (max-width: 800px) {
  .nav-links {
    display: none; position: absolute; top: 100%; left: 0; right: 0;
    background: var(--ink); flex-direction: column; align-items: flex-start;
    padding: 20px 32px; gap: 4px;
  }
  .nav-links.nav-open { display: flex; }
  .menu-toggle { display: block; }
}

/* ---------- ABOUT HERO ---------- */
/* PLACEHOLDER: swap --hero-bg-image below for the real photo once you have it,
   e.g. --hero-bg-image: url('/images/hero-bg.jpg'); */
.about-hero {
  --hero-bg-image: none;
  position: relative;
  padding: 96px 0 64px;
  text-align: center;
  overflow: hidden;
  color: var(--white);
}
.hero-bg {
  position: absolute;
  inset: 0;
  background: var(--brownxorange), var(--brownxorange);
  background-size: cover;
  background-position: center;
  z-index: 0;
}
.hero-bg::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(23,21,18,0.55), rgba(23,21,18,0.75));
}
.about-hero .wrap { position: relative; z-index: 1; }
.about-hero .eyebrow { color: var(--orange); font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 14px; }
.about-hero h1 { font-size: clamp(34px, 5.5vw, 52px); font-weight: 800; margin-bottom: 16px; color: var(--white); }
.about-hero p { color: rgba(253,253,248,0.85); font-size: 16px; max-width: 560px; margin: 0 auto; }

/* ---------- SHARED SECTION STYLES ---------- */
.section { padding: 56px 0; }
.eyebrow { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--orange); margin-bottom: 12px; }
.section h2.heading { font-size: 28px; font-weight: 800; max-width: 560px; margin-bottom: 14px; }

/* ---------- STORY ---------- */
.story-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
.story-copy p { color: var(--muted); font-size: 15px; margin-bottom: 16px; max-width: 460px; }

/* ---------- SLIDESHOW (placeholder, sits right of Our Story) ---------- */
.slideshow { position: relative; border-radius: 18px; overflow: hidden; aspect-ratio: 4/3; background: var(--card-gray); }
.slideshow-track { display: flex; width: 300%; height: 100%; transition: transform 0.6s ease; }
.slide { width: 33.333%; flex-shrink: 0; }
.slide:nth-child(1) { background: var(--card-gray); }
.slide:nth-child(2) { background: #B7B7B0; }
.slide:nth-child(3) { background: #DBDBD2; }
.slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
.slideshow-dots { position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); display: flex; gap: 8px; }
.slideshow-dots .dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(253,253,248,0.6); border: none; cursor: pointer; padding: 0; transition: width 0.2s ease, background 0.2s ease; }
.slideshow-dots .dot.active { background: var(--white); width: 20px; border-radius: 999px; }

/* ---------- STATS ---------- */
.stats-band { background: var(--white); }
.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; text-align: center; }
.stat-card .num { font-size: 34px; font-weight: 800; color: var(--ink); }
.stat-card .label { font-size: 12.5px; color: var(--ink); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 6px; }
.stats-band .section { padding: 44px 0; }

/* ---------- OUR VISION ---------- */
.vision-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: start; }
.how-copy p { color: var(--muted); font-size: 14.5px; margin-bottom: 16px; max-width: 640px; }

.vision-graphic {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: 24px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.vision-graphic img { width: 95%; height: 90%; object-fit: cover; display: block; }
.vision-graphic dotlottie-player { width: 80%; height: 80%; }
@media (max-width: 800px) {
  .vision-grid { grid-template-columns: 1fr; }
  .vision-graphic { max-width: 320px; margin: 0 auto; }
}
.btn { padding: 12px 22px; border-radius: 999px; font-size: 13px; font-weight: 700; border: none; cursor: pointer; display: inline-block; }
.btn-primary { background: var(--ink); color: var(--white); }
.btn-secondary { background: #E3E3DA; color: var(--ink); }
.btn-row { display: flex; gap: 12px; }

/* ---------- TEAM ---------- */
.team-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
.team-card { background: var(--white); border-radius: 14px; padding: 20px; text-align: center; }
.team-avatar { width: 64px; height: 64px; border-radius: 50%; background: var(--card-gray); margin: 0 auto 14px; }
.team-card .name { font-size: 14px; font-weight: 700; }
.team-card .role { font-size: 12.5px; color: var(--muted); margin-top: 4px; }

/* ---------- CTA BAND ---------- */
.cta-band { background: var(--white); padding: 48px 0; }
.cta-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; }
.cta-inner h2 { font-size: 28px; font-weight: 800; max-width: 460px; }

/* ---------- FOOTER ---------- */
footer { background: var(--ink); color: var(--white); }
.footer-top { padding: 56px 0 40px; display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 32px; }
.footer-brand-col .flogo { font-weight: 800; letter-spacing: 0.05em; font-size: 20px; margin-bottom: 12px; }
.footer-brand-col p { color: rgba(253,253,248,0.6); font-size: 13px; max-width: 240px; margin-bottom: 20px; }
.footer-social { display: flex; gap: 12px; }
.footer-social a { width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; }
.footer-social svg { width: 15px; height: 15px; fill: var(--white); }
.footer-col span.topic { display: block; font-weight: 700; font-size: 13px; margin-bottom: 14px; color: var(--orange); text-transform: uppercase; letter-spacing: 0.06em; }
.footer-col a { display: block; font-size: 13px; opacity: 0.8; margin-bottom: 10px; }
.footer-col .contact-line { display: block; font-size: 13px; opacity: 0.8; margin-bottom: 10px; }
.footer-map { margin-top: 8px; border-radius: 14px; overflow: hidden; border: 1px solid rgba(255,255,255,0.12); }
.footer-map iframe { display: block; width: 100%; height: 220px; border: 0; }
.footer-bottom { border-top: 1px solid rgba(255,255,255,0.12); padding: 20px 0; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 12.5px; color: rgba(253,253,248,0.6); }

/* ---------- RESPONSIVE ---------- */
@media (max-width: 900px) {
  .stats-grid { grid-template-columns: 1fr 1fr; }
  .team-grid { grid-template-columns: 1fr 1fr; }
  .footer-top { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 800px) {
  .story-grid, .cta-inner { grid-template-columns: 1fr !important; flex-direction: column; align-items: flex-start; }
}
@media (max-width: 520px) {
  .stats-grid, .team-grid, .footer-top { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
a:focus-visible, button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

/* ---------- DONATE MODAL ---------- */
.donate-modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(23, 15, 5, 0.65);
  backdrop-filter: blur(3px);
  z-index: 1000;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.donate-modal-overlay.is-open {
  display: flex;
}

.donate-modal {
  position: relative;
  background-color: var(--white);
  background-image: url("/Resources/Info%20Tab%20Bg%20Design/Design%201.svg");
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover;
  border: 3px solid var(--white);
  border-radius: 16px;
  max-width: 480px;
  width: 100%;
  padding: 32px;
  box-shadow: 0 20px 50px rgba(0,0,0,0.35);
  animation: event-modal-pop 0.25s ease;
  max-height: 90vh;
  overflow-y: auto;
}

@keyframes event-modal-pop {
  from { opacity: 0; transform: scale(0.95) translateY(8px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.donate-modal-close {
  position: absolute;
  top: 12px;
  right: 16px;
  background: none;
  border: none;
  font-size: 28px;
  line-height: 1;
  color: var(--brown, #5A2A0C);
  cursor: pointer;
}

.donate-modal-eyebrow {
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  font-size: 13px;
  color: var(--orange, #E97C2C);
  margin-bottom: 6px;
}

.donate-modal h3 {
  font-family: 'Lemon Milk', Arial, sans-serif;
  font-size: 24px;
  margin: 0 0 6px;
  color: var(--brown, #5A2A0C);
}

.donate-modal-subtitle {
  font-size: 14px;
  color: var(--muted);
  margin-bottom: 20px;
}

.donate-tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 20px;
  background: rgba(0, 0, 0, 0.05);
  padding: 4px;
  border-radius: 999px;
}

.donate-tab {
  flex: 1;
  padding: 8px 14px;
  border-radius: 999px;
  border: none;
  background: transparent;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  cursor: pointer;
  color: var(--ink);
  transition: all 0.2s ease;
}

.donate-tab.active {
  background: var(--ink);
  color: var(--white);
}

.donate-panel {
  display: none;
}

.donate-panel.active {
  display: block;
}

.donate-info-box {
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(23, 21, 18, 0.1);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
}

.donate-label {
  display: block;
  font-weight: 700;
  text-transform: uppercase;
  font-size: 11px;
  letter-spacing: 0.05em;
  color: var(--green, #163C0A);
  margin-bottom: 8px;
}

.donate-details {
  font-size: 13.5px;
  color: var(--brown, #5A2A0C);
  line-height: 1.5;
}

.donate-desc {
  font-size: 13px;
  color: var(--muted);
  margin-bottom: 10px;
}

.donate-list {
  padding-left: 18px;
  font-size: 13px;
  color: var(--ink);
}

.donate-list li {
  margin-bottom: 6px;
}

.donate-cta {
  width: 100%;
  text-align: center;
  margin-top: 8px;
}

</style>

