<script>
  var menuToggle = document.querySelector('.menu-toggle');
  var navLinks = document.querySelector('.nav-links');
  menuToggle.addEventListener('click', function () {
    var isOpen = navLinks.classList.toggle('nav-open');
    menuToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  // Slideshow placeholder: auto-advance + dot navigation
  (function () {
    var track = document.getElementById('slideshowTrack');
    var dots = document.querySelectorAll('#slideshowDots .dot');
    var index = 0;
    var total = dots.length;
    var timer;

    function goTo(i) {
      index = i;
      track.style.transform = 'translateX(-' + (index * (100 / total)) + '%)';
      dots.forEach(function (d, di) { d.classList.toggle('active', di === index); });
    }

    function next() { goTo((index + 1) % total); }

    function startAuto() {
      clearInterval(timer);
      timer = setInterval(next, 4000);
    }

    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () {
        goTo(i);
        startAuto();
      });
    });

    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reducedMotion) startAuto();
  })();
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // --- DONATE MODAL LOGIC ---
  const donateBtn = document.querySelector('.nav-d[href="#donate"]');
  const donateModal = document.getElementById('donate-modal-overlay');
  const closeDonateBtn = document.getElementById('donate-modal-close');

  donateBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    donateModal?.classList.add('is-open');
  });

  const closeDonateModal = () => donateModal?.classList.remove('is-open');
  closeDonateBtn?.addEventListener('click', closeDonateModal);

  donateModal?.addEventListener('click', (e) => {
    if (e.target === donateModal) closeDonateModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && donateModal?.classList.contains('is-open')) {
      closeDonateModal();
    }
  });

  // Tab switching inside Donate Modal
  const donateTabs = document.querySelectorAll('.donate-tab');
  const donatePanels = document.querySelectorAll('.donate-panel');

  donateTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      donateTabs.forEach(t => t.classList.remove('active'));
      donatePanels.forEach(p => p.classList.remove('active'));

      tab.classList.add('active');
      const targetId = tab.getAttribute('data-donate-target');
      document.getElementById(targetId)?.classList.add('active');
    });
  });

  // --- ARRANGE A DROP-OFF FALLBACK (in case no default mail app is set) ---
  const dropoffBtn = document.getElementById('dropoff-btn');
  const dropoffFeedback = document.getElementById('dropoff-feedback');
  dropoffBtn?.addEventListener('click', () => {
    if (navigator.clipboard) {
      navigator.clipboard.writeText('info@botakibaafrika.org.za').catch(() => {});
    }
    if (dropoffFeedback) {
      dropoffFeedback.style.display = 'block';
      setTimeout(() => { dropoffFeedback.style.display = 'none'; }, 4000);
    }
  });
});
</script>

